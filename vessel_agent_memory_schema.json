  "multi_panel_interface": {
    "architecture": "3-Viewer + Chatbot Panel System",
    "viewer_mode": "Tabs/Windows (not simultaneous panels)",
    "viewers": {
      "markdown_editor": {
        "name": "Markdown/Code Editor (Front View - Cross-Section Analysis)",
