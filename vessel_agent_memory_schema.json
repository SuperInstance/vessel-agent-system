          "tablet": "Full Theia UI",
          "phone": "Read-only, minimal resources",
          "edge_device": "Headless connection only"
        },
        "first_class_citizens": [
          "Markdown documents (daily logs, analysis summaries)",
          "JSON data structures (acoustic signatures, catch events)",
          "Analysis reports (species classification, biomass estimates)",
          "Physical IO logs (switches, encoders, sensors)",
          "Camera feeds (engine room, deck, forward)",
          "Portable controllers (Reason-style racks)"
        ],
        "features": [
          "Markdown preview with syntax highlighting",
          "JSON syntax validation and formatting",
          "Document templates for common analysis types",
          "Agent-generated content integration",
          "Export to PDF, HTML, JSON",
          "Real-time gauge display (marine dashboard)",
          "Camera feed monitoring",
          "Controller rack display (Reason-style)"
