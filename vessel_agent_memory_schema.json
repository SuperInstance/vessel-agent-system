  "storage_architecture": {
    "hive_partitioning": {
      "structure": "/archive_root/year=/month=/day=/vessel_id/",
      "example": "/archive_root/year=2026/month=07/day=24/vessel_id=US-AK-FVCATCHER-01/"
    },
    "parquet_schema": {
      "name": "acoustic_v1_schema",
      "alignment": "ICES SONAR-netCDF4 Convention",
      "fields": [
        {"name": "timestamp_ns", "type": "int64"},
        {"name": "vessel_uuid", "type": "string"},
        {"name": "ping_id", "type": "uint64"},
        {"name": "frequency_hz", "type": "uint32"},
        {"name": "transmit_power_watts", "type": "uint16"},
        {"name": "pulse_length_ms", "type": "float32"},
        {"name": "meters_per_bin", "type": "float32"},
        {"name": "surface_temp_c", "type": "float32"},
        {"name": "sound_velocity_mps", "type": "float32"},
        {"name": "transducer_depth_m", "type": "float32"},
        {"name": "latitude", "type": "float64"},
        {"name": "longitude", "type": "float64"},
        {"name": "heading_true", "type": "float32"},
        {"name": "h3_index_uint64", "type": "uint64"},
        {"name": "backscatter_tensor_db", "type": "list(float32)"},
        {"name": "metadata_extension", "type": "map(string, string)"}
      ]
    },
    "processing": {
      "zero_copy": "Use memoryview for packet parsing",
      "calibration": "Convert raw amplitude to Sv dB",
      "normalization": "Hardware-agnostic physical units"
    }
  },
