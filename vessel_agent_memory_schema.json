  "system_architecture": {
    "development_methodology": {
      "name": "BMAD",
      "description": "Bottom-up, Multi-level, Agile Development",
      "principles": [
        "Bottom-up: Start with raw bits, build upward through abstraction layers",
        "Multi-level: Maintain clear boundaries between abstraction levels",
        "Agile: 2-week sprints with continuous deployment",
        "Long-term vision: 5-year horizon with clear milestones"
      ],
      "abstraction_levels": {
        "level_0": {
          "name": "Raw Bits",
          "description": "Network packets, NMEA bytes, raw sensor data",
          "status": "in_progress",
          "focus": "Lossless UDP packet capture, NMEA parsing, zero-copy ring buffer",
          "success_criteria": {
            "capture_rate": ">99.9%",
            "packet_loss": "<0.1%",
            "uptime": ">99% during operations"
          }
        },
        "level_1": {
          "name": "Physical Tensors",
          "description": "Sv dB, meters per bin, H3 coordinates, physical normalization",
          "status": "planned",
          "focus": "Hardware-agnostic normalization, spatial indexing, physical calibration",
          "success_criteria": {
            "position_error": "<5m at 10 knots",
            "depth_precision": "<0.5m",
            "sv_calibration": "<1dB variance"
          }
        },
        "level_2": {
          "name": "Analytical Features",
          "description": "Biomass density, species signatures, pattern recognition",
          "status": "planned",
          "focus": "Feature extraction, classification, pattern mining",
          "success_criteria": {
            "species_accuracy": ">70% for 3 species",
            "biomass_precision": ">80%",
            "bottom_classification": ">85%"
          }
        },
        "level_3": {
          "name": "Operational Intelligence",
          "description": "Catch predictions, fleet recommendations, route optimization",
          "status": "planned",
          "focus": "Decision support, real-time alerts, collaborative intelligence",
          "success_criteria": {
            "catch_prediction": ">60% at 24h",
            "cpue_improvement": ">15%",
            "fleet_adoption": "5+ vessels"
          }
        },
        "level_4": {
          "name": "Strategic Knowledge",
          "description": "Stock assessments, ecosystem understanding, scenario planning",
          "status": "planned",
          "focus": "Long-term trends, regulatory integration, scientific collaboration",
          "success_criteria": {
            "biomass_estimate": "within 20% of surveys",
            "publications": "3+ peer-reviewed",
            "regulatory_acceptance": "ADF&G integration"
          }
        }
      }
    },
    "roadmap": {
      "year_1": {
        "period": "2026-2027",
